{
  "openapi":"3.0.3",
  "info":{"title":"OrbitOps API","version":"1.0.0","description":"Free, self-hosted multi-tenant HR SaaS API. No external API key required."},
  "servers":[{"url":"http://localhost:4173/api"}],
  "security":[{"bearerAuth":[]}],
  "components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer"}}},
  "paths":{
    "/health":{"get":{"security":[],"responses":{"200":{"description":"Healthy"}}}},
    "/auth/login":{"post":{"security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string"},"password":{"type":"string"}},"required":["email","password"]}}}},"responses":{"200":{"description":"Token issued"},"401":{"description":"Invalid credentials"}}}},
    "/auth/me":{"get":{"responses":{"200":{"description":"Current user"},"401":{"description":"Unauthenticated"}}}},
    "/dashboard":{"get":{"parameters":[{"in":"header","name":"X-Tenant-Id","schema":{"type":"string"}}],"responses":{"200":{"description":"Tenant dashboard"}}}},
    "/employees":{"get":{"responses":{"200":{"description":"Employee list"}}},"post":{"requestBody":{"content":{"application/json":{"schema":{"type":"object"}}}},"responses":{"201":{"description":"Created"}}}},
    "/employees/{id}":{"patch":{"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Updated"}}},"delete":{"parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Deleted"}}}},
    "/requests":{"get":{"responses":{"200":{"description":"Time off requests"}}},"post":{"responses":{"201":{"description":"Created"}}}},
    "/requests/{id}":{"patch":{"responses":{"200":{"description":"Status updated"}}}},
    "/payroll":{"get":{"responses":{"200":{"description":"Payroll"}}}},
    "/billing":{"get":{"responses":{"200":{"description":"Billing summary"}}}},
    "/members":{"get":{"responses":{"200":{"description":"Workspace members"}}}},
    "/audit":{"get":{"responses":{"200":{"description":"Audit activity"}}}},
    "/reports":{"post":{"responses":{"200":{"description":"Report generated"}}}},
    "/webhooks":{"post":{"responses":{"202":{"description":"Event accepted"}}}}
  }
}
